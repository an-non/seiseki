# 声析 — staging ビルド用の設定の見本
#
#   .gitignore が .env.* を除外しているため、実ファイルは追跡されません。
#   CI（.github/workflows/deploy-staging.yml）では環境変数として渡しています。
#   手元で staging と同じ物を組むときは、この見本を .env.staging として複製してください。
#
#     cp local/.env.staging.example local/.env.staging
#     cd local && npm run build:staging
#
#   これが無いと VITE_SEISEKI_API_BASE が空になり、
#   cloudApiEnabled() が常に false になって、回答が Cloudflare に送られません
#   （画面には何も出ないまま、端末内の規則解析に落ちます）。

VITE_SEISEKI_API_BASE=https://seiseki-api-staging.tokyo-odh-129.workers.dev

# true にすると、届かなかったときに端末内の解析へ切り替えずエラーで止まります。
VITE_SEISEKI_API_REQUIRED=false
